# Backend Environment Variables

# Server Configuration
PORT=4000

# Database Configuration
# For docker-compose, use: mongodb://mongodb:27017/mina-cafe
# For external MongoDB, use your connection string
MONGODB_URI=mongodb://mongodb:27017/mina-cafe

# JWT Configuration
# Generate a secure random string for production
# Example: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-in-production

# Kavenegar SMS Service
# Get your API key from https://panel.kavenegar.com/
KAVENEGAR_API_KEY=your-kavenegar-api-key

# Backend Base URL
# Used for generating image URLs
# For local Docker: http://localhost:4001 (Docker uses port 4001 to avoid conflicts)
# For local development (non-Docker): http://localhost:4000
# For production: https://api.yourdomain.com
BASE_URL=http://localhost:4001

# Frontend Environment Variables

# Backend API URL
# This must be set at build time for Next.js
# For local Docker: http://localhost:4001/api (Docker uses port 4001 to avoid conflicts)
# For local development (non-Docker): http://localhost:4000/api
# For production: https://api.yourdomain.com/api
NEXT_PUBLIC_API_URL=http://localhost:4001/api

